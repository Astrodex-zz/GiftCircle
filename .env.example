# Copy this file to .env and set a NEW randomly generated password:
#   python -c 'import secrets;print(secrets.token_urlsafe(32))'
POSTGRES_USER=giftcircle
POSTGRES_DB=giftcircle
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD

# The actual HTTPS URL served through Traefik (no trailing slash).
PUBLIC_URL=https://gifts.example.com
# The web app binds only to localhost on the Docker host; Traefik can forward here.
APP_PORT=8187

# Quick demonstration (no real external email):
# docker compose --profile devmail up -d --build
# Visit http://127.0.0.1:8025 on the Docker host to see intercepted outgoing mail.
MAIL_MODE=smtp
MAIL_FROM=GiftCircle <gifts@example.com>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SSL=false
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=

# For actual family emails replace MAIL_FROM, SMTP_HOST, SMTP_PORT,
# SMTP_SSL/SMTP_STARTTLS and SMTP_USERNAME/SMTP_PASSWORD with your provider settings.
# Do not share or commit .env, credentials, or exported backups.
